# Local overrides for docker-compose.yml. Copy to .env (git-ignored) and edit;
# every variable is optional and falls back to the default shown.

# Host port for Open MCT.
# FRONTEND_PORT=8040
# Host port for the backend API (also reachable through Open MCT at /api).
# BACKEND_PORT=8000

# Links to start: ble, lora, sim, or sim-ble,sim-lora (comma-separated).
# SP_LINKS=ble
# LoRa (SP_LINKS=ble,lora): directory on the host where the firmware's
# radio_app creates its sockets; start it as `radio_app <this directory>`.
# LORA_SOCKET_DIR=./run
# SQLite files inside the container; backend/data/ on the host. Each start
# creates a new one named after it: /data/starpi-0001-20261003-142501.db.
# SP_DB_PATH=/data/starpi.db

# Launch pad (decimal degrees, metres above sea level). Default: competition
# pad A. Pad B: 39.390180 / -8.289189. Pad C: 39.389014 / -8.288250.
# Launch azimuth 145° (B, C: 144°), rail 84°; touchdown 39.387247 / -8.286478, 30 m.
# SP_PAD_LAT=39.392547
# SP_PAD_LON=-8.289517
# SP_PAD_ALTITUDE_M=160
